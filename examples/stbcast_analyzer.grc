    min_len: '200'
    orient: Qt.Horizontal
    rangeType: float
    start: '0'
    step: '10'
    stop: '50'
    value: rx_gain_init
    widget: counter
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [85, 651]
    rotation: 0
    state: true
- name: samp_rate
